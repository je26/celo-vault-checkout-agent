# Vault Checkout Agent — config
# Copy to .env if you add dotenv support; the server reads process env directly.
# Network: sandbox (Celo Sepolia, test USDC, free) or mainnet (real money).
VAULT_NETWORK=sandbox
# Mainnet needs this EXACT value too, so real money is never spent by accident.
VAULT_MAINNET_OK=0
# Server port.
PORT=8787
